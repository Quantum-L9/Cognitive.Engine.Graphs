# --- L9_META ---
# l9_schema: 1
# origin: chassis
# engine: "*"
# layer: [docker]
# tags: [L9_TEMPLATE, docker, engine-agnostic]
# owner: platform-team
# status: active
# --- /L9_META ---
# ─────────────────────────────────────────────────────────────
# L9 Chassis — Multi-stage Dockerfile (Engine-Agnostic)
#
# Build args:
#   ENGINE_PACKAGE — the engine source directory (e.g. "engine", "enrich")
#
# The image ships no domain packs (#400): mount a pack directory at
# /app/domains at runtime; DOMAINS_ROOT selects what the engine serves.
# ─────────────────────────────────────────────────────────────

# ── Stage 1: Dependencies ────────────────────────────────────
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS deps

# git is required to resolve the git+https constellation-node-sdk dependency
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements-runtime.lock requirements-runtime.lock
COPY tools/deps/install_locked.sh tools/deps/install_locked.sh
RUN PIP_PREFIX=/install bash tools/deps/install_locked.sh runtime

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS runtime

ARG ENGINE_PACKAGE=engine

WORKDIR /app

# Installed packages
COPY --from=deps /install /usr/local

# Chassis (shared across all engines)
COPY chassis/ /app/chassis/

# Engine-specific code (parameterized)
COPY ${ENGINE_PACKAGE}/ /app/${ENGINE_PACKAGE}/

# Empty mount point for domain packs (none are baked into the image)
RUN mkdir -p /app/domains

# Entrypoint
COPY scripts/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Non-root user
RUN groupadd -r l9 && useradd -r -g l9 -d /app -s /sbin/nologin l9 \
    && chown -R l9:l9 /app
USER l9

EXPOSE 8000

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD python -c "import httpx; r=httpx.get('http://localhost:8000/v1/health'); exit(0 if r.status_code==200 and r.json().get('ready', True) else 1)"

ENTRYPOINT ["/app/entrypoint.sh"]
