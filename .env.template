─────────────────────────────────────────────────────────────
L9 Graph Cognitive Engine — Environment Variables
Copy to .env and customize for your environment
─────────────────────────────────────────────────────────────

── Neo4j Database ──────────────────────────────────────────
# For Docker: use service name (neo4j)
# For local dev: use localhost with mapped port (7688)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=l9-dev-password
NEO4J_POOL_SIZE=20

── Redis Cache ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

── API Configuration ───────────────────────────────────────
API_KEY=dev-key-sha256-not-for-production
LOG_LEVEL=debug
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

── Scoring Weights ─────────────────────────────────────────
W_STRUCTURAL=0.30
W_GEO=0.25
W_REINFORCEMENT=0.20
W_FRESHNESS=0.10
GEO_DECAY_KM=800.0
COMMUNITY_CROSS_BIAS=0.92
MAX_RESULTS=25

── Domain Configuration ────────────────────────────────────
DOMAINS_ROOT=domains

─────────────────────────────────────────────────────────────
LOCAL DEVELOPMENT ACCESS (from host machine, not Docker)
─────────────────────────────────────────────────────────────
API:           http://localhost:8000/v1/health
Neo4j Browser: http://localhost:7475
Neo4j Bolt:    bolt://localhost:7688
Redis:         localhost:6379
Neo4j Credentials:
  User: neo4j
  Password: l9-dev-password
─────────────────────────────────────────────────────────────

# ── Pareto / Multi-Objective ────────────────────────────────
PARETO_ENABLED=true
PARETO_N_SAMPLES=50
PARETO_WEIGHT_DISCOVERY_ENABLED=false

# ── KGE ─────────────────────────────────────────────────────
KGE_ENABLED=true
KGE_CONFIDENCE_THRESHOLD=0.3
KGE_EMBEDDING_DIM=300

── Gate SDK Configuration ──────────────────────────────────
# Required for Gate self-registration and inter-node routing
GATE_URL=http://gate:9000
GATE_ADMIN_TOKEN=your-gate-admin-token-here
L9_NODE_NAME=graph
L9_NODE_SPEC_PATH=engine/spec.yaml
GATE_REGISTRATION_ENABLED=true
GATE_REGISTER_OVERWRITE=true
GATE_REGISTER_RETRIES=3
GATE_CLIENT_TIMEOUT_SECONDS=30.0
GATE_NODE_SPEC_PATH=engine/spec.yaml

# ── SDK chassis (L9_CHASSIS=sdk) ─────────────────────────────
# Selects the app factory behind chassis.entrypoint:create_app.
# sdk = chassis/node_app.py (default; TransportPacket + Gate-only ingress)
# legacy = chassis/chassis_app.py (dict ExecuteRequest; dev/test only — startup
#          is refused outside L9_ENV=dev while REQUIRE_SDK_CHASSIS_IN_PROD=true)
L9_CHASSIS=sdk

# NodeRuntimeConfig is frozen with extra="forbid" and lru_cached: an
# unrecognised L9_* name is a startup error, not a silent default.
L9_ENVIRONMENT=local
L9_SERVICE_NAME=graph-engine
L9_SERVICE_VERSION=1.1.0
# HOST is also what the node advertises to the Gate on registration.
HOST=0.0.0.0

# Gate-only ingress. Enforced by chassis/node_app.py middleware, not by the
# SDK: NodeRuntimeConfig has no gate-only field. Rejects any /v1/execute packet
# whose provenance.origin_kind != "gate", resolved_by_gate is false, or
# address.source_node != L9_GATE_NODE_NAME.
L9_ENFORCE_GATE_ONLY_INGRESS=true
L9_GATE_NODE_NAME=gate

# Packet signature verification. require_signature=true without a key is a
# preflight failure (fail closed), not a downgrade to unsigned.
L9_REQUIRE_SIGNATURE=true
L9_SIGNING_ALGORITHM=hmac-sha256
L9_SIGNING_KEY=change-me-shared-hmac-secret
L9_SIGNING_KEY_ID=graph-engine-v1
# ed25519 alternative: L9_SIGNING_ALGORITHM=ed25519 + L9_SIGNING_PRIVATE_KEY
# L9_VERIFYING_KEYS_JSON={"gate-v1":"<public-key>"}

# Allowed actions — engine.handlers.ACTION_HANDLERS minus `enrich`: Gate owns
# the `enrich` name for EIE, so CEG must never accept or advertise it.
# `make local-api-sdk` generates this from ACTION_HANDLERS so it cannot drift.
L9_ALLOWED_ACTIONS=match,sync,admin,outcomes,resolve,health,healthcheck

# Attachments are unused by this engine. A non-zero max requires
# L9_ATTACHMENT_ALLOWED_SCHEMES to be set or preflight fails.
L9_MAX_ATTACHMENTS=0
# REQUIRED: the SDK defaults max_attachment_size_bytes to 10MB and
# max_packet_bytes to 256KB, then rejects that pair — so config built from SDK
# defaults alone never validates. Must be <= L9_MAX_PACKET_BYTES.
L9_MAX_ATTACHMENT_SIZE_BYTES=0

# ── Wave 2: Outcome Persistence ─────────────────────────────
OUTCOME_PERSISTENCE_ENABLED=true

# ── Feedback Loop (dormant by default -- two-level gate) ─────
# Global gate below AND the target domain spec must ALSO set
# feedbackloop.enabled: true (see docs/FEATURE_GATES.md). Today only
# plasticos_domain_spec.yaml enables the domain-level flag.
FEEDBACK_ENABLED=false
SCORE_NORMALIZE=false

# ── GDPR Erasure (dormant by default) ────────────────────────
# GDPR_DRY_RUN=true computes erasure scope without executing -- keep true
# unless an operator has explicitly opted into live erasure.
GDPR_ERASURE_ENABLED=false
GDPR_DRY_RUN=true

# ── LLM Provider ──────────────────────────────────────────────
# LLM_PROVIDER defaults to "openai" even if unset; OPENAI_API_KEY is
# required before any LLM-backed feature (safe_eval NL rules, etc.) runs.
LLM_PROVIDER=openai
OPENAI_API_KEY=

# ── PacketStore Persistence (dormant by default) ─────────────
# Dual-gated with settings.outcome_persistence_enabled. Requires a
# reachable PostgreSQL instance at PACKET_STORE_DSN when enabled.
PACKET_STORE_ENABLED=false
PACKET_STORE_DSN=postgresql://l9_engine:l9-dev-password@postgres:5432/l9_graph

# ── PostgreSQL (ComplianceEngine audit-flush pool) ───────────
# Optional/soft dependency -- unset (None) disables audit flush with a
# warning log; does not block startup. Independently-lazy asyncpg pool
# from PACKET_STORE_DSN above (see engine/boot.py vs engine/packet/packet_store.py)
# -- same Postgres instance may back both, do not merge them.
POSTGRES_DSN=postgresql://l9_engine:l9-dev-password@postgres:5432/l9_graph
