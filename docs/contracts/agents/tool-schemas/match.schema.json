  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quantum-L9/Cognitive.Engine.Graphs/docs/contracts/agents/tool-schemas/match.schema.json",
  "title": "MatchActionPayload",
  "description": "CEG match handler accepts legacy graph-match input and, when the server's match_request_contract_admission flag is enabled (default True), a contract-versioned MatchRequest from engine/models/payloads.py. Source: engine/handlers.py:_match_request_as_legacy and handle_match at bcf66bdbf56f7c35d059a6e16c3006bcc1395ba0. This schema describes the admitted client shapes; the runtime does not execute this JSON schema. ",
  "type": "object",
  "properties": {
    "query": {
      "type": "object",
      "description": "Domain-governed field values; exact keys and gate constraints come from the approved tenant domain spec.",
      "additionalProperties": true
    },
    "match_direction": {
      "type": "string",
      "minLength": 1,
      "description": "Direction declared in domain.queryschema.matchdirections."
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 10,
      "description": "Client contract bound. Existing handler coerces/clamps out-of-range values rather than rejecting them."
    },
    "weights": {
      "type": "object",
      "description": "Existing match dimension overrides; keys are domain-controlled and effective sum is checked by handler feature flag.",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "default": {}
    },
    "contract_version": {
      "const": "1.0.0-draft",
      "description": "Required for typed MatchRequest; admission is controlled by server flag."
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Typed request domain. Must match admitted DomainContract and packet tenant at runtime."
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "description": "Typed direction, checked against DomainContract.match_directions."
    },
    "query_entity_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[^\\s]+$"
    },
    "projection_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_ref": {
      "$ref": "#/$defs/semver_ref"
    },
    "field_dictionary_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [],
  "additionalProperties": false,
