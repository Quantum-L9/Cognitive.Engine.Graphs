# --- L9_META ---
# l9_schema: 1
# origin: l9-template
# engine: graph
# layer: [docker]
# tags: [L9_TEMPLATE, docker, prod]
# owner: platform
# status: active
# --- /L9_META ---
#
# L9 Engine — Multi-stage Production Dockerfile

FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS builder

WORKDIR /build

# git is retained for native build prerequisites used by the runtime dependency set.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# uv.lock is the single lock: install_locked.sh bootstraps a hash-pinned uv into
# this stage's interpreter and syncs the runtime profile into /opt/venv, which
# is all the final stage copies (uv itself stays behind).
COPY pyproject.toml uv.lock ./
COPY tools/deps/install_locked.sh tools/deps/uv-bootstrap.txt tools/deps/
RUN UV_PROJECT_ENVIRONMENT=/opt/venv bash tools/deps/install_locked.sh runtime

COPY engine/ ./engine/
COPY domains/ ./domains/
COPY chassis/ ./chassis/

# --- Production ---
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ARG L9_PROJECT=l9-engine
ARG L9_ENV=prod

WORKDIR /app

# Copy the locked environment + app code. The venv's interpreter links to
# /usr/local/bin/python3.12, which this stage shares (same base digest).
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=builder /build/engine ./engine
COPY --from=builder /build/domains ./domains
COPY --from=builder /build/chassis ./chassis

ENV L9_PROJECT=$L9_PROJECT \
    L9_ENV=$L9_ENV \
    L9_LIFECYCLE_HOOK=engine.boot:GraphLifecycle \
    API_PORT=8000 \
    API_WORKERS=4 \
    LOG_LEVEL=INFO \
    PYTHONUNBUFFERED=1

# Run as a non-root user (parity with Dockerfile / Dockerfile.chassis). The
# API binds port 8000 (>1024), so no elevated privilege is required at runtime.
RUN groupadd -r l9 && useradd -r -g l9 -d /app -s /sbin/nologin l9 \
    && chown -R l9:l9 /app
USER l9

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import json,sys,urllib.request; sys.exit(0 if json.load(urllib.request.urlopen('http://localhost:8000/v1/health')).get('ready', True) else 1)"

CMD ["uvicorn", "chassis.entrypoint:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
